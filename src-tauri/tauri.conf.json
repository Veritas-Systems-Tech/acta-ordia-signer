{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Acta Ordia Signer",
  "version": "0.1.0",
  "identifier": "com.actaordia.signer",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [
        "https://TODO-set-real-release-endpoint.actaordia.com/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "TODO-generate-with-`cargo tauri signer generate`-before-first-release"
    }
  }
}
